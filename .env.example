# Copie para .env e preencha.
APIFY_TOKEN=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Provedor da classificação: anthropic (Claude) ou deepseek.
# Sem esta linha, usa a DeepSeek quando só a chave dela estiver preenchida.
# RADAR_PROVEDOR_IA=deepseek

# Opcionais (valores padrão entre parênteses)
# RADAR_MODELO=claude-haiku-5-5   (ou deepseek-flash / deepseek-v4-pro)
# RADAR_SEGUIDORES_MIN=300
# RADAR_SEARCH_LIMIT=30
# RADAR_PROFUNDIDADE_MAX=2
# RADAR_CONFIANCA_EXPANSAO=0.7
# RADAR_MAX_USD_POR_RUN=10
# Preço de referência da Apify em US$ por 1000 resultados (só para a estimativa do --dry-run)
# RADAR_PRECO_BUSCA_1K=2.30
# RADAR_PRECO_PERFIL_1K=2.30
# RADAR_PRECO_HASHTAG_1K=2.30
# RADAR_PRECO_GOOGLE_1K=4.50

# Coleta pelo navegador: teto de leituras por conta e intervalos da vigilância (horas)
# RADAR_NAV_MAX_DIA=800
# RADAR_NAV_MAX_HORA=100
# RADAR_VIGIA_FOCO_H=1
# RADAR_VIGIA_ALTA_H=2
# RADAR_VIGIA_MEDIA_H=6
# RADAR_VIGIA_BAIXA_H=24
# Volta (vigiar --volta): leituras por hora por conta, sempre dentro do teto por hora
# RADAR_VIGIA_VOLTA_POR_HORA=60
